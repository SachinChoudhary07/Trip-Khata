// TripKhata rules. The Firebase project (flutter-apps-975a6) is shared with
// other apps, so DON'T replace the existing rules: paste only the block between
// "TripKhata: start" and "TripKhata: end" inside your existing
// `match /databases/{database}/documents { ... }` block, next to the other apps' rules.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- TripKhata: start ----
    function tkSignedIn() { return request.auth != null; }
    function tkTrip(tripId) { return get(/databases/$(database)/documents/tripkhata_trips/$(tripId)); }

    match /tripkhata_trips/{tripId} {
      // Only people in the trip can read it. Strangers can't list or read trips.
      allow read: if tkSignedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if tkSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;
      allow update: if (tkSignedIn() && request.auth.uid in resource.data.memberUids)
        // Joining with a code: you may add only yourself and change nothing else.
        || (tkSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
            && request.resource.data.memberUids.hasAll(resource.data.memberUids)
            && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
            && request.auth.uid in request.resource.data.memberUids);
      allow delete: if tkSignedIn() && resource.data.ownerUid == request.auth.uid;

      match /{sub}/{docId} {
        allow read: if tkSignedIn() && request.auth.uid in tkTrip(tripId).data.memberUids;
        allow write: if sub != 'photos' && tkSignedIn() && request.auth.uid in tkTrip(tripId).data.memberUids;
      }

      // Photos: anyone in the trip adds their own; only the person who
      // uploaded a photo can change or delete it.
      match /photos/{photoId} {
        allow create: if tkSignedIn()
          && request.auth.uid in tkTrip(tripId).data.memberUids
          && request.resource.data.uploaderUid == request.auth.uid;
        allow update: if tkSignedIn()
          && resource.data.uploaderUid == request.auth.uid
          && request.resource.data.uploaderUid == request.auth.uid;
        allow delete: if tkSignedIn() && resource.data.uploaderUid == request.auth.uid;
      }
    }

    // Join codes: look one up by its exact code (get), never list them.
    match /tripkhata_codes/{code} {
      allow get: if tkSignedIn();
      allow list: if false;
      allow create: if tkSignedIn()
        && request.resource.data.keys().hasOnly(['tripId', 'ownerUid', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in tkTrip(request.resource.data.tripId).data.memberUids;
      allow delete: if tkSignedIn() && request.auth.uid in tkTrip(resource.data.tripId).data.memberUids;
    }

    // Push tokens: each person reads and writes only their own doc.
    // The Cloud Functions use the Admin SDK, which skips these rules.
    match /tripkhata_users/{uid} {
      allow read, write: if tkSignedIn() && request.auth.uid == uid;
    }
    // ---- TripKhata: end ----

  }
}
