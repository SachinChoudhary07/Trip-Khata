<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tk_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tk_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tk_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="ACTIVE TRIP"
            android:textColor="#F2B33D"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tk_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="TripKhata"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tk_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#CCE3E7"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/tk_type"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/tk_round_outline"
        android:contentDescription="Type an expense"
        android:padding="10dp"
        android:src="@drawable/tk_ic_keyboard" />

    <ImageView
        android:id="@+id/tk_mic"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/tk_round_fill"
        android:contentDescription="Speak to add an expense"
        android:padding="13dp"
        android:src="@drawable/tk_ic_mic" />
</LinearLayout>
